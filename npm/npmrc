# Global npm settings (for the npm CLI specifically).
# Managed declaratively via home-manager (~/config/nixos/home/taylan.nix).
# Project-level .npmrc overrides any setting here.
#
# Most pnpm-specific supply-chain settings (minimumReleaseAge etc.) live in
# ~/.config/pnpm/config.yaml — pnpm 10+ stopped reading them from .npmrc.

# Honor `engines.node` in package.json — refuse to install on unsupported Node.
engine-strict=true

# Noise reduction.
fund=false
audit-level=moderate

# Auth token — sourced from environment, never committed. Set NPM_TOKEN in a
# non-committed shell file (or a sops/age-managed secret) before publishing.
# `npm login` will NOT work against this file (it's a read-only symlink into
# the Nix store) — use the env var instead.
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
